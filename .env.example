TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
OWNER_ID=123456789
GOOGLE_DRIVE_DESTINATION_ID=your_destination_folder_or_shared_drive_folder_id

# Primary auth: Service Account (recommended for bot servers)
# Inline JSON (single line) OR path to JSON file (e.g. ./service-account.json)
SERVICE_ACCOUNT_JSON=./service-account.json

# Optional fallback auth: OAuth Refresh Token
# Used when the service account cannot access the source/destination but your Google account can.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

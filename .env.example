TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
OWNER_ID=123456789
# Optional: comma-separated group/chat IDs where all members can use /c.
# /n remains owner-only.
# AUTHORIZED_CHAT_IDS=-1001234567890,-1009876543210
GOOGLE_DRIVE_DESTINATION_ID=your_destination_folder_or_shared_drive_folder_id

# Primary auth: Service Account (recommended for bot servers)
# Inline JSON (single line), path to JSON file, or JSON array of either.
SERVICE_ACCOUNT_JSON=./service-account.json

# Optional fallback auth: OAuth Refresh Token
# Used when service accounts cannot access the source/destination but your Google account can.
# GOOGLE_OAUTH_CREDENTIALS=[{"client_id":"...","client_secret":"...","refresh_token":"..."}]

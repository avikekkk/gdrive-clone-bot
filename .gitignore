.env
.codex
.DS_Store

# Runtime state.
logs/
*.log
*.db
*.db-journal

# Compiled binaries.
/clonebot
/oauthtoken

# Local credentials. Keep .env.example committed, but never commit real secrets.
# Service account and OAuth client files land in the repo root, so ignore every
# root-level JSON file rather than trying to guess their names.
/*.json
service-account*.json
*service*account*.json
*credentials*.json
client_secret*.json

# Reference material, not part of the build.
/ref/
